# Copy to .env:  cp .env.example .env   (PowerShell: Copy-Item .env.example .env)
# Every value below is the built-in default, so this file works unchanged for local use.

# --- Storage ---
# Relative storage paths are resolved from backend/, regardless of launch directory.
BOARDOM_DATABASE_URL=sqlite:///data/boardom.db
BOARDOM_UPLOAD_DIR=data/uploads
BOARDOM_MAX_UPLOAD_BYTES=10485760

# --- Text extraction ---
BOARDOM_MAX_PDF_PAGES=200
BOARDOM_MAX_EXTRACTED_CHARACTERS=500000
BOARDOM_EXTRACTION_TIMEOUT_SECONDS=60

# --- Sessions and browser security ---
BOARDOM_SESSION_LIFETIME_SECONDS=604800
# Set true behind HTTPS in production.
BOARDOM_COOKIE_SECURE=false
# Exact browser origin. Use localhost consistently (not 127.0.0.1 in the browser).
BOARDOM_FRONTEND_ORIGIN=http://localhost:3000
# development, test, or production
BOARDOM_ENVIRONMENT=development

# --- Accounts ---
# When true, /register is shown and creates teacher accounts. Off: the admin creates teachers.
BOARDOM_ALLOW_PUBLIC_SIGNUP=false
# Created on first start only if no user has this email. Restarting never resets the password.
# Use a real domain or example.com (special-use domains such as .local are rejected).
BOARDOM_ADMIN_EMAIL=admin@example.com
# CHANGE BOTH before sharing the app. The API refuses to start in production with these defaults.
BOARDOM_ADMIN_PASSWORD=BoardomAdmin#2026
# Used only by "Forgot admin password?". It can only be changed here (no endpoint shows it).
BOARDOM_ADMIN_RESET_PIN=482916
# Students each teacher may create unless the admin sets a per-teacher limit.
BOARDOM_DEFAULT_STUDENT_LIMIT=4

# --- AI ---
# Paste your own key into backend/.env only (never into this file or into Git).
# Empty key = offline demo mode: AI features return canned "[demo]" answers, no network.
BOARDOM_OPENAI_API_KEY=
# OpenAI-compatible gateway. Leave empty to use api.openai.com.
BOARDOM_OPENAI_BASE_URL=https://genailab.tcs.in/
# false DISABLES TLS certificate checking. Hackathon gateway only; refused in production.
BOARDOM_AI_VERIFY_TLS=false
# openai = real calls when a key is set; fake = always offline (tests, demos).
BOARDOM_AI_PROVIDER=openai
BOARDOM_MODEL_SMART=genailab-openai-gpt-5.6-luna
BOARDOM_MODEL_FAST=genailab-openai-gpt-5.6-luna
BOARDOM_MODEL_EMBEDDING=text-embedding-3-small
BOARDOM_MODEL_MODERATION=omni-moderation-latest
BOARDOM_AI_TIMEOUT_SECONDS=60
BOARDOM_AI_MAX_RETRIES=2
# Study videos: narration model and voice (silent captioned slides when TTS is unavailable).
BOARDOM_MODEL_TTS=gpt-4o-mini-tts
BOARDOM_TTS_VOICE=alloy
BOARDOM_VIDEO_TTS=true
# Exam-prep coach: minimum source match before answering (otherwise "not covered").
BOARDOM_COACH_MIN_SCORE=0.2

# --- Sources and search ---
# ChromaDB vector index folder (relative to backend/). Safe to delete: it is rebuilt.
BOARDOM_CHROMA_DIR=data/chroma
# Images and scanned PDF pages are read by this vision model (empty = BOARDOM_MODEL_SMART).
BOARDOM_MODEL_VISION=
BOARDOM_MAX_OCR_PAGES=20
# Web research searches only these domains (JSON list).
BOARDOM_TRUSTED_DOMAINS=["wikipedia.org","britannica.com","khanacademy.org","openstax.org","ocw.mit.edu","nptel.ac.in","ncert.nic.in","bbc.co.uk","nature.com","nasa.gov"]

# --- Guardrails ---
# Per-user daily AI limits (model calls; cost only counts models with known prices; 0 = off).
BOARDOM_DAILY_AI_CALLS_PER_USER=500
BOARDOM_DAILY_AI_COST_USD_PER_USER=5
# true: reject text when the moderation service is unreachable (default: allow and log).
BOARDOM_MODERATION_REQUIRED=false
