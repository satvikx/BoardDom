# Relative storage paths are resolved from backend/, regardless of launch directory.
BOARDOM_DATABASE_URL=sqlite:///data/boardom.db
BOARDOM_UPLOAD_DIR=data/uploads
BOARDOM_MAX_UPLOAD_BYTES=10485760
BOARDOM_SESSION_LIFETIME_SECONDS=604800
# Set true behind HTTPS in production.
BOARDOM_COOKIE_SECURE=false
# Exact browser origin. Use localhost consistently (not 127.0.0.1 in the browser).
BOARDOM_FRONTEND_ORIGIN=http://localhost:3000
BOARDOM_ENVIRONMENT=development
